{
  "name": "song-of-the-river",
  "version": "0.8.0",
  "private": true,
  "description": "A cosy illustrated expedition adventure from mountain springs to the open sea.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:assets": "node scripts/audit-release.mjs",
    "release": "node scripts/package-release.mjs",
    "audit:release": "node scripts/audit-release.mjs --dist"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.1.0",
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "sharp": "^0.35.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "author": "Nic Pittman (pCO₂)",
  "files": [
    "src",
    "public/art",
    "public/audio/sfx",
    "public/licenses",
    "public/manifest.webmanifest",
    "index.html",
    "vite.config.ts",
    "tsconfig.json",
    "scripts/audit-release.mjs",
    "README.md",
    "CREDITS.md",
    "LICENSE",
    "LICENSE-ASSETS.md",
    ".github",
    ".gitignore",
    "scripts/package-release.mjs"
  ]
}
